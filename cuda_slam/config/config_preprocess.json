{
  "description": "Point cloud preprocessing configuration",
  "voxel_downsample": {
    "enabled": true,
    "resolution": 0.2
  },
  "passthrough_filter": {
    "enabled": true,
    "x_min": -80.0,
    "x_max": 80.0,
    "y_min": -80.0,
    "y_max": 80.0,
    "z_min": -5.0,
    "z_max": 30.0
  },
  "ring_filter": {
    "enabled": false,
    "min_ring": 0,
    "max_ring": 63
  },
  "range_filter": {
    "enabled": true,
    "min_range": 0.3,
    "max_range": 80.0
  },
  "motion_compensation": {
    "enabled": true,
    "method": "imu_linear",
    "max_time_offset": 0.1
  },
  "feature_extraction": {
    "enabled": true,
    "edge_threshold": 0.1,
    "planar_threshold": 0.05,
    "num_regions": 6,
    "num_edge_features": 200,
    "num_planar_features": 400,
    "min_range_for_features": 0.5
  },
  "normal_estimation": {
    "enabled": true,
    "search_k": 20,
    "search_radius": 0.5,
    "max_nn_distance": 1.0
  },
  "cuda": {
    "enabled": true,
    "block_size": 256,
    "streams": 4
  }
}