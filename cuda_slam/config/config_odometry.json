{
  "description": "LiDAR odometry frontend configuration",
  "voxel_grid": {
    "resolution": 1.0,
    "max_points_per_voxel": 20
  },
  "registration": {
    "num_threads": 8,
    "max_iterations": 30,
    "translation_convergence_threshold": 0.001,
    "rotation_convergence_threshold": 0.01,
    "max_correspondence_distance": 3.0,
    "correspondence_random_sampling_rate": 0.9,
    "max_correspondences": 5000,
    "num_neighbors": 20,
    "kernel": {
      "type": "huber",
      "huber_delta": 0.5
    },
    "plane_resolution": 0.5,
    "plane_min_points": 5,
    "plane_max_curvature": 0.01
  },
  "smoother": {
    "type": "lag",
    "smoother_lag": 5,
    "initial_timestamp": 0.0
  },
  "keyframe": {
    "strategy": "adaptive",
    "translation_threshold": 1.0,
    "rotation_threshold_deg": 15.0,
    "min_frame_interval": 5,
    "max_frame_interval": 50,
    "min_keyframe_overlap": 0.3,
    "max_keyframes": 200
  },
  "initial_guess": {
    "use_imu": true,
    "use_constant_velocity": true,
    "gravity_vector": [0.0, 0.0, -9.81]
  },
  "submap": {
    "enabled": true,
    "submap_size": 50,
    "submap_overlap": 10,
    "max_submaps": 20
  },
  "deskew": {
    "enabled": true,
    "max_deskew_dt": 0.05
  },
  "point_cloud": {
    "min_points": 100,
    "max_points_per_scan": 28800,
    "use_intensity": true,
    "min_intensity": 0.0,
    "max_intensity": 255.0
  },
  "outlier_rejection": {
    "enabled": true,
    "statistical_outlier_removal_k": 10,
    "statistical_outlier_removal_std_mul": 1.0,
    "radius_outlier_removal_radius": 0.1,
    "radius_outlier_removal_min_neighbors": 5
  },
  "cuda": {
    "enabled": true,
    "block_size": 256,
    "streams": 4,
    "use_managed_memory": false,
    "prefetch_distance": 2
  }
}